{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "best-card-picker/merchants.schema.json",
  "title": "Best Card Picker merchants.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "merchants"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "merchants": { "type": "array", "items": { "$ref": "cards.schema.json#/$defs/merchant" } }
  }
}
