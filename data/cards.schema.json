{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "best-card-picker/cards.schema.json",
  "title": "Best Card Picker cards.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "pointValuesCents", "cards"],
  "properties": {
    "version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pointValuesCents": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9_]+$" },
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } },
    "merchants": { "type": "array", "items": { "$ref": "#/$defs/merchant" } }
  },
  "$defs": {
    "category": {
      "enum": ["restaurant", "us_supermarket", "online_grocery", "gas_ev", "streaming", "drugstore", "us_online_retail", "airline_united", "airline_aa", "airline_direct", "hotel_direct", "chase_travel", "amex_travel_prepaid_hotel", "vacation_rental", "rideshare_transit", "rental_car", "wholesale_club", "general"]
    },
    "network": { "enum": ["amex", "visa", "mastercard", "discover"] },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "rate"],
      "properties": {
        "category": { "$ref": "#/$defs/category" },
        "rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "capUsdPerYear": { "type": "number", "exclusiveMinimum": 0 },
        "usOnly": { "type": "boolean" },
        "verify": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "network", "currency", "foreignFeePct", "baseRate", "rules"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "shortCode": { "type": "string", "pattern": "^[A-Z0-9]{1,4}$" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "network": { "$ref": "#/$defs/network" },
        "currency": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "foreignFeePct": { "type": "number", "minimum": 0, "maximum": 10 },
        "baseRate": { "type": "number", "minimum": 0, "maximum": 100 },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
        "preferredFor": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "reason"],
            "properties": { "category": { "$ref": "#/$defs/category" }, "reason": { "type": "string", "maxLength": 200 } }
          }
        },
        "enabled": { "type": "boolean" },
        "last4": { "type": "string", "pattern": "^[0-9]{4,5}$" },
        "verify": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string", "maxLength": 500 }
      }
    },
    "merchant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "category"],
      "properties": {
        "match": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "category": { "$ref": "#/$defs/category" },
        "inStoreNetworks": { "type": "array", "items": { "$ref": "#/$defs/network" } },
        "onlineNetworks": { "type": "array", "items": { "$ref": "#/$defs/network" } },
        "mayNotTakeAmex": { "type": "boolean" },
        "verify": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
